{
  "provider": "modal",
  "app": "podvigil-modal",
  "environment": "main",
  "image": "python:3.13.7-slim-bookworm",
  "gpu": "L4",
  "cpu": 0.25,
  "memory_mib": 512,
  "timeout_seconds": 120,
  "finalize_seconds": 30,
  "command": ["python3", "smoke.py", "--gpu"],
  "inputs": { "smoke.py": "smoke.py" },
  "required_artifacts": ["result.json"],
  "estimated_hourly_usd": 1.0,
  "max_compute_cost_usd": 0.05,
  "rate_checked_utc": "2000-01-01T00:00:00+00:00",
  "block_network": true,
  "max_backup_bytes": 10485760,
  "max_backup_files": 100
}
